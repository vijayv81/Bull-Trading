# Anthropic credentials — usually unnecessary if you're logged in via `ant auth login`.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used by the research/strategy agents (full ID or alias like "opus"/"sonnet").
TRADING_AGENT_MODEL=claude-opus-5

# Comma-separated tickers the routine scans by default.
WATCHLIST=AAPL,MSFT,NVDA,SPY

# Where market data and agent outputs are stored (relative to project root).
DATA_DIR=data
